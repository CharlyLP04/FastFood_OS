{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://alaburger-os-2fyu.onrender.com/api/$1"
    },
    {
      "src": "/(assets/.*)",
      "dest": "client/dist/$1"
    },
    {
      "src": "/(.*\\.(ico|png|jpg|jpeg|svg|css|js|json|webmanifest|txt))",
      "dest": "client/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html"
    }
  ]
}
