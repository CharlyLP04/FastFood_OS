# Variables de entorno para A La Burger OS - Servidor

# Puerto en el que correrá el servidor
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# CORS — Whitelist de orígenes permitidos (HU-1)
# Lista separada por comas de los dominios autorizados en producción.
# Ejemplos: tu-app.vercel.app,tu-preview.vercel.app
# En desarrollo, localhost:5173 y localhost:3000 se añaden automáticamente.
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://tu-app.vercel.app,https://tu-preview.vercel.app

# NOTA FUTURA (HU-JWT-COOKIES): Cuando el JWT se mueva a httpOnly cookies,
# activar credentials: true en corsConfig.js y agregar aquí el dominio exacto
# de Vercel. Las cookies cross-origin solo viajan con credentials: true +
# el cliente usando fetch(..., { credentials: 'include' }).

# URL del frontend (Vite corre por defecto en 5173)
FRONTEND_URL=http://localhost:5173

# URL de conexión a la base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DB_URL=postgresql://usuario:contraseña@localhost:5432/alaburger_os

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
# Genera una segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_min_32_chars

# Stripe (modo test) - Developers > API keys en dashboard.stripe.com
STRIPE_SECRET_KEY=tu_clave_de_stripe_aqui